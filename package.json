{
  "name": "@adguard/dead-domains-linter",
  "description": "Simple tool to check adblock filtering rules for dead domains.",
  "keywords": [
    "adblock",
    "adguard",
    "filter",
    "linter",
    "list",
    "ublock"
  ],
  "author": "AdGuard Software Ltd.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdguardTeam/DeadDomainsLinter.git"
  },
  "bugs": {
    "url": "https://github.com/AdguardTeam/DeadDomainsLinter/issues"
  },
  "homepage": "https://github.com/AdguardTeam/DeadDomainsLinter#readme",
  "files": [
    "src"
  ],
  "bin": {
    "dead-domains-linter": "src/cli.js"
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=10.33.4 <11"
  },
  "dependencies": {
    "@adguard/agtree": "1.1.8",
    "consola": "3.2.3",
    "glob": "10.4.5",
    "node-fetch": "2.7.0",
    "tldts": "6.1.86",
    "yargs": "17.7.2"
  },
  "devDependencies": {
    "@babel/core": "7.28.0",
    "@babel/eslint-parser": "7.28.0",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "48.11.0",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "jsdoc": "4.0.4",
    "markdownlint": "0.41.1",
    "markdownlint-cli": "0.49.1"
  },
  "scripts": {
    "lint": "pnpm lint:code && pnpm lint:md",
    "lint:code": "eslint . --cache",
    "lint:md": "markdownlint .",
    "test": "jest --runInBand --detectOpenHandles --verbose .",
    "prepare": "husky"
  }
}
